Description: Find minkteec and minkadaptor via pkgconf
 Use pkg_check_modules() instead of linking against bare library names, so
 include paths and link flags come from the installed .pc files.
Author: Lukas Märdian <lukas.maerdian@oss.qualcomm.com>
Forwarded: https://github.com/qualcomm/minkipc/pull/110
---
Index: pkg-optee-test/CMakeLists.txt
===================================================================
--- pkg-optee-test.orig/CMakeLists.txt
+++ pkg-optee-test/CMakeLists.txt
@@ -37,6 +37,9 @@ add_subdirectory (ta)
 ################################################################################
 # Packages
 ################################################################################
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(MINKTEEC REQUIRED IMPORTED_TARGET minkteec)
+pkg_check_modules(MINKADAPTOR REQUIRED IMPORTED_TARGET minkadaptor)
 find_package(Threads REQUIRED)
 if(NOT THREADS_FOUND)
 	message(FATAL_ERROR "Threads not found")
@@ -145,8 +148,8 @@ target_link_libraries (${PROJECT_NAME}
 	PRIVATE m
 	PRIVATE xtest-ta-headers
 	PRIVATE ckqteec
-	PRIVATE minkteec
-	PRIVATE minkadaptor
+	PRIVATE PkgConfig::MINKTEEC
+	PRIVATE PkgConfig::MINKADAPTOR
 	PRIVATE ${CMAKE_THREAD_LIBS_INIT}
 	PRIVATE ${OPENSSL_PRIVATE_LINK}
 )
