Description: Find minkteec and minkadaptor via pkgconf
 Use pkg_check_modules() instead of linking against bare library names, so
 include paths and link flags come from the installed .pc files.
Author: Lukas Märdian <lukas.maerdian@oss.qualcomm.com>
Forwarded: https://github.com/qualcomm/minkipc/pull/110
---
Index: pkg-optee-test/CMakeLists.txt
===================================================================
--- pkg-optee-test.orig/CMakeLists.txt	2026-10-13 12:22:39.833815215 +0200
+++ pkg-optee-test/CMakeLists.txt	2026-10-13 12:22:48.644692201 +0200
@@ -37,6 +37,9 @@
 ################################################################################
 # Packages
 ################################################################################
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(MINKTEEC REQUIRED minkteec)
+pkg_check_modules(MINKADAPTOR REQUIRED minkadaptor)
 find_package(Threads REQUIRED)
 if(NOT THREADS_FOUND)
 	message(FATAL_ERROR "Threads not found")
@@ -140,12 +143,18 @@
 	${GP_INCLUDES}
 )
 
+# Search the minkipc include dir last: its tee_client_api.h is the libminkteec
+# one, while xtest needs the optee-client header from /usr/include.
+foreach(dir ${MINKTEEC_INCLUDE_DIRS} ${MINKADAPTOR_INCLUDE_DIRS})
+	target_compile_options(${PROJECT_NAME} PRIVATE -idirafter ${dir})
+endforeach()
+
 target_link_libraries (${PROJECT_NAME}
 	PRIVATE m
 	PRIVATE xtest-ta-headers
 	PRIVATE ckqteec
-	PRIVATE minkteec
-	PRIVATE minkadaptor
+	PRIVATE ${MINKTEEC_LINK_LIBRARIES}
+	PRIVATE ${MINKADAPTOR_LINK_LIBRARIES}
 	PRIVATE ${CMAKE_THREAD_LIBS_INIT}
 	PRIVATE ${OPENSSL_PRIVATE_LINK}
 )
